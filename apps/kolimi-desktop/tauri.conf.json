{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kolimi-desktop",
  "version": "0.1.12",
  "identifier": "dev.kolimi.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "trayIcon": {
      "iconPath": "icon.png"
    },
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Kolimi desktop client",
    "longDescription": "Native Kolimi desktop client: browse and share files in a window and keep a local folder in sync in the background."
  }
}
