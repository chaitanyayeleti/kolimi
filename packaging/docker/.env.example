# Copy to .env next to compose.traefik.yaml and edit.

# ── Required for the Traefik stack ──────────────────────────────────────
KOLIMI_DOMAIN=cloud.example.com
ACME_EMAIL=admin@example.com

# ── Optional ────────────────────────────────────────────────────────────
# Pin/upgrade the image without editing the compose file.
#KOLIMI_IMAGE=ghcr.io/chaitanyayeleti/kolimi:0.1.41

# Server knobs passed through by compose.yaml / compose.traefik.yaml.
#KOLIMI_USER_QUOTA_BYTES=0
#KOLIMI_METRICS_PER_USER=1
RUST_LOG=info
