# Copy to .env next to compose.traefik.yaml and edit.
KOLIMI_DOMAIN=cloud.example.com
ACME_EMAIL=admin@example.com

# Basic-auth users for the /metrics endpoint (the app serves it without
# authentication, so Traefik guards it). Generate the value with:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB metrics 'change-me'
# which prints e.g.  metrics:$2y$05$abcdef...  — paste that whole line
# below. Keep a single '$'; do not escape it here.
KOLIMI_METRICS_USERS=metrics:$2y$05$REPLACE_WITH_HTPASSWD_OUTPUT
