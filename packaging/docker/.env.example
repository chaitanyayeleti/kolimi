# Copy to .env next to compose.traefik.yaml and edit.

# ── Required for the Traefik stack ──────────────────────────────────────
KOLIMI_DOMAIN=cloud.example.com
ACME_EMAIL=admin@example.com

# ── Optional ────────────────────────────────────────────────────────────
# Pin/upgrade the image without editing the compose file.
#KOLIMI_IMAGE=ghcr.io/chaitanyayeleti/kolimi:0.7.1

# Server knobs passed through by compose.yaml / compose.traefik.yaml.
#KOLIMI_USER_QUOTA_BYTES=0
#KOLIMI_METRICS_PER_USER=1
# Read-only token accepted only by /metrics.
#KOLIMI_METRICS_TOKEN=change-me
RUST_LOG=info

# Audit checkpoint signing (0.7.1+) is configured in compose.traefik.yaml,
# not here: mount the key read-only and set KOLIMI_AUDIT_SIGNING_KEY to the
# container path. The host file must be owned by UID 65532, mode 0600.
