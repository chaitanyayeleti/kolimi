# Release image built from the already-compiled glibc binaries.
#
# The CI build jobs upload `dist/kolimi-<target>/` and the container step
# uses that directory as its context, so the release no longer compiles the
# server a second time inside Docker.
#
# The gnu binaries are built on the pinned Ubuntu 24.04 runners (glibc
# 2.39). The runtime base must therefore be at least that new; Debian 12's
# glibc 2.36 made `v0.4.1` exit at startup with GLIBC_2.38 not found.
FROM gcr.io/distroless/cc-debian13:nonroot

COPY kolimi-server /usr/local/bin/kolimi-server
COPY kolimi-sync /usr/local/bin/kolimi-sync
COPY --chown=nonroot:nonroot README.md /data/.keep

ENV KOLIMI_DATA=/data \
    KOLIMI_BIND=0.0.0.0:8080 \
    KOLIMI_ORIGIN=http://localhost:8080 \
    RUST_LOG=info
VOLUME /data
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/kolimi-server", "serve"]
