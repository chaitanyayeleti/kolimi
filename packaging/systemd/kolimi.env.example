# Kolimi server environment. Copy to /etc/kolimi/kolimi.env and edit.
# The systemd unit reads this file (EnvironmentFile=-/etc/kolimi/kolimi.env).

KOLIMI_DATA=/var/lib/kolimi
KOLIMI_BIND=127.0.0.1:8080

# Public origin users visit; must match the URL for passkeys (WebAuthn).
KOLIMI_ORIGIN=https://cloud.example.com

# TLS termination (leave unset when a reverse proxy terminates TLS).
#KOLIMI_TLS_CERT=/etc/kolimi/tls/cert.pem
#KOLIMI_TLS_KEY=/etc/kolimi/tls/key.pem

# Set when serving over TLS directly (or when the proxy forwards https).
#KOLIMI_SECURE_COOKIES=true

# Log level.
RUST_LOG=info
