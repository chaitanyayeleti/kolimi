# Kolimi environment reference.
#
# Copy to `.env` only when your launcher reads it (Docker Compose uses
# packaging/docker/.env; systemd uses /etc/kolimi/kolimi.env). A bare
# `kolimi-server serve` reads the real process environment.
#
# Values below are the defaults unless marked "optional". Secrets are
# commented out so they are never committed by accident.

# ── Server ──────────────────────────────────────────────────────────────
KOLIMI_BIND=127.0.0.1:8080
KOLIMI_DATA=./kolimi-data
KOLIMI_ORIGIN=http://localhost:8080
RUST_LOG=info

# TLS termination. Leave unset when a reverse proxy terminates TLS.
#KOLIMI_TLS_CERT=/etc/kolimi/tls/cert.pem
#KOLIMI_TLS_KEY=/etc/kolimi/tls/key.pem
#KOLIMI_SECURE_COOKIES=true

# Set when a trusted reverse proxy (Traefik/Caddy/nginx) forwards
# X-Forwarded-For, so rate limiting and login lockout see real client IPs.
#KOLIMI_TRUST_PROXY=1

# Default per-user storage quota in bytes (0 = unlimited). A per-user
# value set with `kolimi-server user quota` overrides this.
KOLIMI_USER_QUOTA_BYTES=0

# Opt in to per-user Prometheus gauges (high cardinality on big instances).
#KOLIMI_METRICS_PER_USER=1

# OTLP/gRPC trace export; only compiled in with `--features otel`.
#KOLIMI_OTEL_ENDPOINT=http://127.0.0.1:4317

# Weakens the preview sandbox. Only use on kernels without Landlock.
#KOLIMI_PREVIEW_ALLOW_NO_LANDLOCK=1

# ── Installer ───────────────────────────────────────────────────────────
# Used by scripts/install.sh instead of prompting / putting the password
# in the process list.
#KOLIMI_ADMIN_PASSWORD=change-me

# ── Sync CLI (kolimi-sync) ──────────────────────────────────────────────
KOLIMI_SERVER=https://cloud.example.com
KOLIMI_USER=alice
#KOLIMI_PASSWORD=change-me
# Prefer these over passing secrets on the command line.
#KOLIMI_E2EE_PASSPHRASE=change-me
#KOLIMI_E2EE_RECOVERY=word-word-word-...
#KOLIMI_E2EE_PRF=64-hex-characters

# ── Desktop client ──────────────────────────────────────────────────────
# Override the desktop config file (default ~/.config/kolimi/desktop.json).
#KOLIMI_DESKTOP_CONFIG=/home/alice/.config/kolimi/desktop.json
# Start minimized to the tray.
#KOLIMI_START_HIDDEN=1

# ── Docker Compose + Traefik ────────────────────────────────────────────
# See packaging/docker/.env.example; these are substituted by compose.
#KOLIMI_DOMAIN=cloud.example.com
#ACME_EMAIL=admin@example.com

# ── Build / tests ───────────────────────────────────────────────────────
# Some glibc/musl builds need this for aws-lc-rs.
#AWS_LC_SYS_NO_JITTER_ENTROPY=1
# Make the Landlock sandbox test fail instead of skip on unsupported kernels.
#KOLIMI_REQUIRE_LANDLOCK=1
