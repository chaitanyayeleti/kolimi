// The Kolimi plugin ABI (component model).
//
// Plugins export `handle` and receive exactly the host functions below:
// logging, a plugin-scoped key-value store, and the clock. There is no
// filesystem, network, or process access — the sandbox is the import
// list, enforced by wasmtime.

package kolimi:plugin@0.1.0;

interface host {
    /// Log a message (levels: debug, info, warn, error).
    log: func(level: string, message: string);
    /// Milliseconds since the Unix epoch.
    now-millis: func() -> u64;
    /// Read a value from the plugin's private key-value store.
    kv-get: func(key: string) -> option<list<u8>>;
    /// Write a value to the plugin's private key-value store.
    kv-set: func(key: string, value: list<u8>);
}

interface api {
    record request {
        method: string,
        path: string,
        user: string,
        body: list<u8>,
    }
    record response {
        status: u16,
        content-type: string,
        body: list<u8>,
    }
    handle: func(request: request) -> response;
}

world plugin {
    import host;
    export api;
}
